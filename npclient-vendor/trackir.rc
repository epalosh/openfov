/* Version resource for the TrackIR presence shim.
 *
 * An unsigned, symbol-stripped executable with no version information at
 * all is a meaningful antivirus heuristic signal on its own -- the shipped
 * 0.2.1 binary had none, and Defender classified it as
 * Trojan:Win32/Ravartar!rfn. This block makes the file self-describing.
 *
 * The metadata is deliberately honest: it identifies OpenFOV, not
 * NaturalPoint. The *filename* has to be TrackIR.exe because that is what
 * games look for in the process list, but nothing here claims to be
 * NaturalPoint's product.
 */

#include <winver.h>

/* Generated by build.ps1 immediately before windres runs, so the version
   never has to survive shell quoting on the windres command line. */
#include "trackir_version.h"

#ifndef OPENFOV_VERSION_CSV
#define OPENFOV_VERSION_CSV 0,0,0,0
#endif
#ifndef OPENFOV_VERSION_STR
#define OPENFOV_VERSION_STR "0.0.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION     OPENFOV_VERSION_CSV
PRODUCTVERSION  OPENFOV_VERSION_CSV
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"    /* U.S. English, Unicode */
        BEGIN
            VALUE "CompanyName",      "OpenFOV Project"
            VALUE "FileDescription",  "OpenFOV TrackIR compatibility shim"
            VALUE "FileVersion",      OPENFOV_VERSION_STR
            VALUE "InternalName",     "trackir_shim"
            VALUE "LegalCopyright",   "MIT (c) 2026 OpenFOV Contributors"
            VALUE "OriginalFilename", "TrackIR.exe"
            VALUE "ProductName",      "OpenFOV"
            VALUE "ProductVersion",   OPENFOV_VERSION_STR
            VALUE "Comments",         "Presence-only helper. Holds a message-only window so games that check for a running TrackIR.exe will initialize head tracking. Source: https://github.com/epalosh/openfov"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x04B0
    END
END
